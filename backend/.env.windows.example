# Windows 环境配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# 应用配置
APP_NAME=人员定位监控系统
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# 数据库配置
# 注意: Windows 上建议使用 Docker Desktop 运行 PostgreSQL
# 或者安装 PostgreSQL for Windows: https://www.postgresql.org/download/windows/
DATABASE_URL=postgresql+asyncpg://kf_user:kf_password@localhost:5432/personnel_tracking

# Redis配置
# 注意: Windows 上建议使用 Docker Desktop 运行 Redis
# 或者使用 Memurai (Redis for Windows): https://www.memurai.com/
REDIS_URL=redis://localhost:6379/0

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 钉钉机器人配置
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=xxx

# 文件上传配置 (使用相对路径，自动适配 Windows)
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_SIZE=104857600

# AI模型配置 (使用相对路径，自动适配 Windows)
MODEL_DIR=../data/models
DEFAULT_MODEL=yolov11n.engine

# 日志配置 (使用相对路径，自动适配 Windows)
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
